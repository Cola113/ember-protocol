# The Ember Protocol — environment template
# Copy to `.env.local` for local Next.js. Do not put real secrets in git.
#
# Current P0–P5 frontend plays with empty env (saves are localStorage;
# /api/voices, /api/scribe, /api/curator are Canon stubs).
# T2: GET /api/ai/ping without keys returns model_unavailable.
# Keys below are placeholders — fill only what you actually wire up.

# -----------------------------------------------------------------------------
# Public Next.js (inlined at build time; never put secrets in NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=The Ember Protocol
# Optional analytics / preview banner (leave empty to disable)
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_ANALYTICS_ID=

# -----------------------------------------------------------------------------
# AI providers — P2 Voices / Scribe / Curator (Vercel AI SDK)
# T2 wiring: lib/ai/provider.ts + GET /api/ai/ping
# No key → contract error model_unavailable (degraded: true). Never put real keys here.
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-key
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
# OPENAI_API_KEY=sk-your-openai-key
# XAI_API_KEY=xai-your-xai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# GROQ_API_KEY=gsk_your-groq-key

# Provider selection for the T2 ping / generateObject / streamText skeleton.
# Generic AI_SDK_* overrides apply to the selected provider only.
# GEMINI_MODEL / OPENAI_MODEL / *_BASE_URL are ignored unless they match AI_SDK_PROVIDER.
# AI_SDK_PROVIDER=google
# AI_SDK_MODEL=gemini-2.0-flash
# AI_SDK_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_MODEL=grok-2
# XAI_BASE_URL=https://api.x.ai/v1

# Which provider/model each layer should call (examples only; T3–T5)
# AI_PROVIDER=xai
# AI_MODEL_VOICES=grok-4
# AI_MODEL_SCRIBE=grok-4
# AI_MODEL_CURATOR=grok-4
# AI_GATEWAY_API_KEY=your-ai-gateway-key

# -----------------------------------------------------------------------------
# Data stores
# T2 is local-first: browser localStorage + Node memory. Postgres is optional later.
# Playable progress still uses lib/save-system.ts (ember_protocol_save_*).
# P2 caches use lib/datastore.ts (ember_protocol_ds_*). No NextAuth in T2.
# -----------------------------------------------------------------------------
# EMBER_DATASTORE=memory
# POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/ember
# POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST:5432/ember
# POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST:5432/ember?pgbouncer=true
# KV_URL=rediss://default:PASSWORD@HOST:PORT
# KV_REST_API_URL=https://YOUR_KV.kv.vercel-storage.com
# KV_REST_API_TOKEN=your-kv-rest-token
# KV_REST_API_READ_ONLY_TOKEN=your-kv-read-token
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# -----------------------------------------------------------------------------
# Auth — cross-device saves (NextAuth; not implemented in the current build)
# -----------------------------------------------------------------------------
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-a-long-random-string
# AUTH_SECRET=replace-with-a-long-random-string
# AUTH_GITHUB_ID=your-github-oauth-app-id
# AUTH_GITHUB_SECRET=your-github-oauth-app-secret

# -----------------------------------------------------------------------------
# Vercel / runtime
# -----------------------------------------------------------------------------
# VERCEL_ENV=development
# VERCEL_URL=ember-protocol.vercel.app
# VERCEL_PROJECT_ID=prj_your-project-id
# VERCEL_ORG_ID=team_your-team-id
# Node AI routes in DESIGN.md use maxDuration = 300 (set in the route, not env)
